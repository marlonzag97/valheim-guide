        "barley-wine-base-fire-resistance"
      ]
    },
    {
      "id": "cloudberries-quelle",
      "name": {
        "de": "Moltebeeren",
        "en": "Cloudberries"
      },
      "fundort": "Büsche überall in den Ebenen, wachsen nach 5 Stunden nach. Nahrung, Köder für Loxe und Zutat für Gerstenwein und Pastete.",
      "wofuer": [
        "cloudberries",
        "unbaked-lox-pie",
