{
  "id": "sumpf",
  "reihenfolge": 3,
  "name": {
    "de": "Sumpf",
    "en": "Swamp"
  },
  "farbe": "sumpf",
  "untertitel": "Gift, Nässe und Eisen in versunkenen Krypten.",
  "status": "voll",
  "boss": {
    "id": "bonemass",
    "name": {
      "de": "Knochenmasse",
      "en": "Bonemass"
    },
    "altar": "Verlassener Altar mitten im Sumpf. Den Ort verrät ein Vegvisir-Runenstein, den du in den Sumpfgrüften (manchmal auch in Ruinen) liest.",
    "opfergabe": [
      {
        "item": "withered-bone",
        "menge": 10
      }
    ],
    "belohnung": [
      "wishbone",
      "bonemass-trophy"
    ],
    "macht": {
      "name": "Knochenmasse",
      "wirkung": "Etwas weniger Schaden durch Stumpf, Hieb und Stich (etwa 25 %). Blocken kostet keine Ausdauer und bringt sogar etwas zurück. 5 Minuten aktiv, 20 Minuten Abklingzeit."
    },
    "leben": 5000,
    "schwaeche": [
      "Stumpf",
      "Frost"
    ],
    "resistenz": [
      "Hieb",
      "Stich (stark)",
      "Feuer (stark)",
      "Gift (immun)"
    ]
  },
  "vorbereitung": [
    {
      "item": "poison-resistance-mead",
      "grund": "Gift ist die Waffe des Sumpfs. Der Met senkt Gift-Schaden um 75 %, zehn Minuten lang. Trink ihn vor dem Kampf, nicht danach.",
      "pflicht": true
    },
    {
      "item": "karve",
      "grund": "Sümpfe liegen selten auf der Startinsel. Meist musst du übers Meer und am besten an einer Wiese oder einem Schwarzwald neben dem Sumpf anlegen.",
      "pflicht": true
    },
    {
      "item": "bronze-plate-cuirass",
      "grund": "Bronzerüstung ist das Minimum. Draugr schlagen mit 48 bis 58 Hieb-Schaden zu, ohne Rüstung bist du schnell tot.",
      "pflicht": true
    },
    {
      "item": "bronze-axe",
      "grund": "Alte Rinde gibt es nur von den Uralten Bäumen im Sumpf, und die fällst du mindestens mit der Bronzeaxt.",
      "pflicht": true
    },
    {
      "item": "bronze-buckler",
      "grund": "Draugr-Angriffe parieren (L2 im letzten Moment) lässt sie lange taumeln.",
      "pflicht": false
    },
    {
      "item": "bronze-pickaxe",
      "grund": "Jede Spitzhacke baut Schlammhaufen ab. Die Bronzespitzhacke hält nur länger als die Geweihspitzhacke.",
      "pflicht": false
    },
    {
      "item": "smelter",
      "grund": "Eisenschrott wiegt 10 pro Stück und lässt sich nicht durchs Portal schicken. Eine Schmelze im Sumpf-Lager spart dir viel Schlepperei.",
      "pflicht": false
    },
    {
      "item": "minor-healing-mead",
      "grund": "Notfall-Heilung, wenn Draugr oder Egel dich erwischen.",
      "pflicht": false
    },
    {
      "item": "carrot-soup",
      "grund": "Essen ist Rüstung. Drei verschiedene Sorten, sonst sind die Egel schneller als dein Leben.",
      "pflicht": false
    },
    {
      "item": "hoe",
      "grund": "Mit der Harke ziehst du Pfade über das Wasser und ebnest später die Altar-Arena.",
      "pflicht": false
    }
  ],
  "gefahren": [
    {
      "id": "draugr",
      "name": {
        "de": "Draugr",
        "en": "Draugr"
      },
      "gefahr": 3,
      "schwaeche": [],
      "resistenz": [
        "Feuer",
        "Gift (immun)"
      ],
      "tipp": "Der Standardgegner des Sumpfs, 100 Leben. Drei von vier tragen eine Axt (48 Hieb), der Rest einen Bogen. Blocke im letzten Moment (L2), dann taumelt er und du hast Zeit für mehrere Treffer. Gegen Bogenschützen im Zickzack laufen. Lässt Innereien fallen, die du für Würste brauchst.",
      "drops": [
        "entrails",
        "draugr-trophy"
      ]
    },
    {
      "id": "draugr-elite",
      "name": {
        "de": "Elite Draugr",
        "en": "Draugr elite"
      },
      "gefahr": 4,
      "schwaeche": [],
      "resistenz": [
        "Feuer",
        "Gift (immun)"
      ],
      "tipp": "200 Leben und 58 Hieb-Schaden mit dem Schwert, spawnt nachts in der Sumpfmitte. Parieren oder Ausweichrolle (L2 + Kreis) und dann zuschlagen. Seine Trophäe brauchst du für den Eisen-Vorschlaghammer.",
      "drops": [
        "entrails",
        "draugr-elite-trophy"
      ]
    },
    {
      "id": "leech",
      "name": {
        "de": "Schlundegel",
        "en": "Leech"
      },
      "gefahr": 3,
      "schwaeche": [],
      "resistenz": [
        "Gift",
        "Feuer (immun)",
        "Geist (immun)"
      ],
      "tipp": "Lauert im Wasser und beißt mit Gift (70 Gift, 20 Stich). Nur 60 Leben, aber im tiefen Wasser kannst du nicht angreifen. Halte dich an Land, achte auf Wellen im Wasser und ziehe mit der Harke Pfade. Vom Ufer aus mit Bogen oder Speer wehren.",
      "drops": [
        "bloodbag",
        "leech-trophy"
      ]
    },
    {
      "id": "blob",
      "name": {
        "de": "Schleimling",
        "en": "Blob"
      },
      "gefahr": 2,
      "schwaeche": [
        "Stumpf",
        "Frost",
        "Blitz"
      ],
      "resistenz": [
        "Feuer",
        "Stich",
        "Hieb",
        "Gift (immun)"
      ],
      "tipp": "Kleiner Schleimklumpen mit 50 Leben, der in deine Nähe springt und eine Giftwolke platzen lässt. Die lässt sich nicht blocken. Mit der Keule oder einem Streitkolben ein Schlag, oder aus der Ferne mit dem Bogen.",
      "drops": [
        "ooze",
        "blob-trophy"
      ]
    },
    {
      "id": "oozer",
      "name": {
        "de": "Schleimmasse",
        "en": "Oozer"
      },
      "gefahr": 3,
      "schwaeche": [
        "Stumpf",
        "Frost",
        "Blitz"
      ],
      "resistenz": [
        "Feuer",
        "Stich",
        "Hieb",
        "Gift (immun)"
      ],
      "tipp": "Große Version mit 150 Leben und 8 Metern Giftwolke. Beim Tod zerfällt sie in zwei Schleimlinge. Kommt nachts, lässt mit etwa einem Drittel Chance Eisenschrott fallen. Stumpfe Waffe nehmen, Abstand halten, vorher Giftresistenz-Met trinken.",
      "drops": [
        "ooze",
        "scrap-iron"
      ]
    },
    {
      "id": "wraith",
      "name": {
        "de": "Zorngeist",
        "en": "Wraith"
      },
      "gefahr": 4,
      "schwaeche": [
        "Feuer",
        "Geist"
      ],
      "resistenz": [
        "Stumpf",
        "Stich",
        "Hieb",
        "Frost (immun)",
        "Gift (immun)"
      ],
      "tipp": "Fliegt nachts durch den Sumpf, nur 100 Leben, aber 60 Hieb-Schaden und nimmt von normalen Waffen wenig. Fackel oder Feuerpfeile helfen. Er greift mit einem einzigen Kratzer an, also parieren (L2) und zuschlagen. Meide den Sumpf nachts. Lässt Ketten fallen.",
      "drops": [
        "chain",
        "wraith-trophy"
      ]
    },
    {
      "id": "surtling",
      "name": {
        "de": "Surtling",
        "en": "Surtling"
      },
      "gefahr": 2,
      "schwaeche": [
        "Frost"
      ],
      "resistenz": [
        "Feuer (immun)",
        "Gift (immun)",
        "Geist (immun)"
      ],
      "tipp": "Kleiner Feuerteufel an Feuer-Geysiren, 20 Leben, wirft Feuerbälle. Im Dauerregen tun sie wenig Schaden. Wasser tötet sie, also Geysir-Umgebung mit der Harke absenken: Surtlinge verenden beim Erscheinen und du sammelst Surtlingkerne und Kohle ein.",
      "drops": [
        "surtling-core",
        "coal",
        "surtling-trophy"
      ]
    },
    {
      "id": "abomination",
      "name": {
        "de": "Monstrosität",
        "en": "Abomination"
      },
      "gefahr": 4,
      "schwaeche": [
        "Feuer"
      ],
      "resistenz": [
        "Stumpf",
        "Stich (stark)",
        "Frost (immun)",
        "Gift (immun)",
        "Geist (immun)"
      ],
      "tipp": "Baumähnlicher Riese mit 800 Leben, langsam, aber 60 bis 80 Stumpf-Schaden pro Schlag. Hieb-Waffen (Axt, Schwert) funktionieren am besten, Feuerpfeile auch. Mit Bandenschild parieren (L2) macht den Kampf viel kürzer. Lässt Wurzeln und Glibber fallen.",
      "drops": [
        "root",
        "guck",
        "abomination-trophy"
      ]
    }
  ],
