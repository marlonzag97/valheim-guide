      ]
    },
    {
      "id": "tar-quelle",
      "name": {
        "de": "Teer",
        "en": "Tar"
      },
      "fundort": "In und um Teergruben, die von Düsterblobs bewacht werden. Die Grube leerst du, indem du mit der Harke einen Graben bergab ziehst. Danach holst du den Teer von Hand ab: kleine Klumpen bringen 4, große am Grund 15.",
      "wofuer": [
        "darkwood-pole-2m",
        "darkwood-beam-2m",
        "shingle-roof-26",
        "black-metal-chest"
      ]
    },
    {
      "id": "needle-quelle",
      "name": {
        "de": "Nadel",
        "en": "Needle"
      },
      "fundort": "Todesmücken lassen je eine fallen, dazu liegen Nadeln in Truhen der Dörfer (2 bis 5).",
      "wofuer": [
        "needle-arrow",
        "porcupine"
      ]
    },
    {
      "id": "lox-meat-quelle",
      "name": {
        "de": "Loxfleisch",
        "en": "Lox meat"
      },
      "fundort": "Von Loxen, 4 bis 5 Stück pro Tier. Roh essen geht nicht, es muss auf die Eisenkochstation oder in Pastete.",
      "wofuer": [
        "cooked-lox-meat",
        "unbaked-lox-pie"
      ]
    },
    {
      "id": "lox-pelt-quelle",
      "name": {
        "de": "Loxfell",
        "en": "Lox pelt"
      },
      "fundort": "Von Loxen, 2 Stück pro Tier.",
      "wofuer": [
        "lox-cape",
        "bracelets-of-the-brave"
      ]
    },
    {
      "id": "fuling-totem-quelle",
      "name": {
        "de": "Fuling-Totem",
        "en": "Fuling totem"
      },
      "fundort": "Auf einem Altar neben den Feuern der Fuling-Dörfer (je 50 % Chance), garantiert in manchen Außenposten, mit 10 % von Berserkern und selten in der Mittelkiste der Steinmonumente. Du brauchst fünf.",
      "wofuer": []
    },
    {
      "id": "fine-wood-ebenen-quelle",
      "name": {
        "de": "Feinholz",
        "en": "Fine wood"
      },
      "fundort": "Von Birken, die in den Ebenen vereinzelt stehen. Du brauchst viel davon, also fäll zwischendurch mit der Eisenaxt mit.",
      "werkzeug": "Axt",
      "wofuer": [
        "blast-furnace",
