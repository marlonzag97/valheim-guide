{
  "id": "ebenen",
  "reihenfolge": 5,
  "name": {
    "de": "Ebenen",
    "en": "Plains"
  },
  "farbe": "ebenen",
  "untertitel": "Fulinge, Todesmücken, Schwarzmetall und Gerste.",
  "status": "voll",
  "boss": {
    "id": "yagluth",
    "name": {
      "de": "Yagluth",
      "en": "Yagluth"
    },
    "altar": "Yagluths Altar (Forsaken Altar) in den Ebenen. Den Ort verrät ein Vegvisir-Runenstein in den Steinmonumenten (Stonehenge), den es aber nur mit kleiner Chance gibt. Oft ist es einfacher, den Altar direkt zu suchen.",
    "opfergabe": [
      {
        "item": "fuling-totem",
        "menge": 5
      }
    ],
    "belohnung": [
      "torn-spirit",
      "yagluth-trophy"
    ],
    "macht": {
      "name": "Yagluth",
      "wirkung": "50 % weniger Blitzschaden, +25 auf die Ackerbau-Fertigkeit (Farming) und 10 % mehr Schaden. 5 Minuten aktiv, 20 Minuten Abklingzeit."
    },
    "leben": 10000,
    "schwaeche": [],
    "resistenz": [
      "Feuer",
      "Stich (stark)",
      "Gift (immun)",
      "Taumeln (immun)"
    ]
  },
  "vorbereitung": [
    {
      "item": "dragon-tear",
      "grund": "Moders Drachentränen (2 Stück) öffnen den Kunsthandwerkstisch. Ohne ihn gibt es hier weder Hochofen noch Windmühle noch Spinnrad.",
      "pflicht": true
    },
    {
      "item": "iron",
      "grund": "Eisenbarren für Eisennägel (Windmühle, Spinnrad), Hochofen, Steinofen und die Gepolsterte Rüstung. Nimm mindestens 100 mit.",
      "pflicht": true
    },
    {
      "item": "surtling-core",
      "grund": "5 für den Hochofen, 4 für den Steinofen.",
      "pflicht": true
    },
    {
      "item": "fine-wood",
      "grund": "Hochofen, Spinnrad, Zubereitungstisch und alle Schwarzmetallwaffen brauchen Feinholz. Birken gibt es auch in den Ebenen.",
      "pflicht": true
    },
    {
      "item": "coal",
      "grund": "2 Kohle pro Schwarzmetallbarren. Nimm einen großen Vorrat mit oder bau gleich einen Köhler in die Nähe.",
      "pflicht": true
    },
    {
      "item": "cultivator",
      "grund": "Gerste und Flachs wachsen nur in den Ebenen. Mit dem Kultivator pflanzt du sie nach, sobald du erste Samen aus einem Fuling-Dorf hast.",
      "pflicht": true
    },
    {
      "item": "campfire",
      "grund": "Gegen Fulinge, die nachts in Gruppen kommen, hilft ein Lager mit Feuer, Bett und Dach.",
      "pflicht": false
    },
    {
      "item": "fire-resistance-barley-wine",
      "grund": "Für Yagluth. Die Gerste dafür findest du erst hier, also brau ihn später.",
      "pflicht": false
    }
  ],
  "gefahren": [
    {
      "id": "deathsquito",
      "name": {
        "de": "Todesmücke",
        "en": "Deathsquito"
      },
      "gefahr": 4,
      "schwaeche": [],
      "resistenz": [
        "Geist (immun)",
        "Taumeln (immun)"
      ],
      "tipp": "Winzig (10 Leben), aber schnell und tödlich: Ein Stich macht 90 Stichschaden. Sie schwirren schon am Strand heran und verfolgen dich bis weit aufs Wasser. Waffe immer in der Hand halten, den Stich abwarten und dann sofort zuschlagen. Die Nadel, die sie fallen lassen, brauchst du für Nadelpfeile und den Porcupine.",
      "drops": [
        "needle",
        "deathsquito-trophy"
      ]
    },
    {
      "id": "fuling",
      "name": {
        "de": "Fuling",
        "en": "Fuling"
      },
      "gefahr": 3,
      "schwaeche": [],
      "resistenz": [
        "Geist (immun)"
      ],
      "tipp": "Kleine, flinke Goblins mit Keule, Speer, Schwert oder Fackel. Ein Treffer macht um die 85 Schaden, der Speer fliegt auf 14 Meter. Sie hören extrem gut, schon Holzfällen oder Erzabbau lockt sie an. Nachts kommen bis zu fünf auf einmal. Einzeln anlocken, mit dem Bogen ausdünnen und im Wasser oder Graben erwischen: Sie schwimmen schlecht. Sie lassen Schwarzmetall-Schrott fallen.",
      "drops": [
        "black-metal-scrap",
        "fuling-trophy"
      ]
    },
    {
      "id": "fuling-berserker",
      "name": {
        "de": "Fuling-Berserker",
        "en": "Fuling berserker"
      },
      "gefahr": 5,
      "schwaeche": [],
      "resistenz": [
        "Geist (immun)"
      ],
      "tipp": "Der Brocken der Fulinge: 800 Leben, schlägt mit 130 stumpfem Schaden zu und zerlegt Bäume und Felsen. Seine Wut-Attacke (alle 20 Sekunden) besteht aus drei Keulenschlägen nacheinander. Aus der Distanz anschießen, bei der Wut zurückweichen und nur zwischen den Schlägen kontern. Er lässt 3 bis 4 Schrott fallen und mit 10 % Chance ein Fuling-Totem.",
      "drops": [
        "black-metal-scrap",
        "fuling-totem",
        "fuling-berserker-trophy"
      ]
    },
    {
      "id": "fuling-shaman",
      "name": {
        "de": "Fuling-Schamane",
        "en": "Fuling shaman"
      },
      "gefahr": 3,
      "schwaeche": [],
      "resistenz": [
        "Geist (immun)"
      ],
      "tipp": "Nur 100 Leben, aber er schützt alle Fulinge im Umkreis von 6 Metern mit einem Schild, das 100 Schaden schluckt, und schießt Feuerbälle (Brennen). Zuerst ausschalten, am besten mit dem Bogen, sonst fressen deine Pfeile die Schilde der anderen.",
      "drops": [
        "black-metal-scrap",
        "fuling-shaman-trophy"
      ]
    },
    {
      "id": "lox",
      "name": {
        "de": "Lox",
        "en": "Lox"
      },
      "gefahr": 4,
      "schwaeche": [
        "Feuer"
      ],
      "resistenz": [
        "Stumpf",
        "Frost",
        "Hieb",
        "Geist (immun)"
      ],
      "tipp": "Riesig (1000 Leben), beißt (130 Hieb) und stampft (120 stumpf plus Flächenschaden auf Holz und Stein). Sie bleiben in Herden und werden aggressiv, sobald du dich näherst. Eine Grube oder Pfeile aus der Distanz helfen, Feuerpfeile am besten. Wirf ihnen aber lieber Moltebeeren, Flachs oder Gerste hin: Loxe sind zähmbar, liefern Fleisch und Fell, und ein Sattel macht sie zum Reittier.",
      "drops": [
        "lox-meat",
        "lox-pelt",
        "lox-trophy"
      ]
    },
    {
      "id": "growth",
      "name": {
        "de": "Düsterblob",
        "en": "Growth"
      },
      "gefahr": 3,
      "schwaeche": [
        "Stumpf",
        "Feuer"
      ],
      "resistenz": [
        "Frost",
        "Stich",
        "Hieb",
        "Gift (immun)",
        "Taumeln (immun)"
      ],
      "tipp": "Lebt in Teergruben. Verschießt sechs Teerkugeln auf einmal (Gift und Teer-Debuff) und ist in der Teergrube schwer zu sehen. Stumpfe Waffen und Feuerpfeile wirken am besten. Mehrere auf einmal sind gefährlich, also ziehe sie aus der Grube heraus. Er lässt Teer fallen.",
      "drops": [
        "tar",
        "growth-trophy"
      ]
    },
    {
      "id": "vile",
      "name": {
        "de": "Vile",
        "en": "Vile"
      },
      "gefahr": 4,
      "schwaeche": [
        "Feuer",
        "Geist"
      ],
      "resistenz": [
        "Frost",
        "Stumpf",
        "Stich",
        "Hieb",
        "Gift (immun)"
      ],
      "tipp": "Untote, stärkere Bären-Variante, die nur nachts durch die Ebenen streift (1200 Leben). Weicht Feuer aus: Eine Fackel in der Hand lässt viele Schläge danebengehen. Aus der Distanz mit Feuerpfeilen, sonst drauf und weg. Er frisst Blaubeeren vom Boden, ist aber nicht zähmbar.",
      "drops": [
        "bear-hide",
        "bear-meat",
        "vile-trophy"
      ]
    }
  ],
  "rohstoffe": [
    {
