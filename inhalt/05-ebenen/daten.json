        "black-metal-sword"
      ]
    },
    {
      "id": "chain-quelle",
      "name": {
        "de": "Kette",
        "en": "Chain"
      },
      "fundort": "Lässt sich nicht herstellen. Wraiths im Sumpf lassen sie fallen, dazu liegt sie in Sumpftruhen und in den Versiegelten Türmen (Sealed Tower) der Ebenen, die du mit Hildirs Karte findest.",
      "wofuer": [
        "black-metal-shield",
        "black-metal-tower-shield",
        "iron-cooking-station"
      ]
