  "name": { "de": "Schwarzwald", "en": "Black Forest" },
  "farbe": "schwarzwald",
  "untertitel": "Kupfer, Zinn, Bronze. Der erste richtige Schritt nach vorn.",
  "status": "voll",
  "boss": {
    "id": "the-elder",
    "name": { "de": "Der Älteste", "en": "The Elder" },
    "altar": "Altar des Ältesten im Schwarzwald, umringt von vier Säulen. Den Ort verrät ein Vegvisir-Runenstein, den du in Grabkammern (manchmal auch in Ruinen) findest.",
    "opfergabe": [{ "item": "ancient-seed", "menge": 3 }],
    "belohnung": ["swamp-key", "the-elder-trophy"],
    "macht": { "name": "Der Älteste", "wirkung": "60 % mehr Schaden mit Axt und Spitzhacke (Holzfällen und Abbau geht schneller) und 30 % mehr Lebensregeneration. 5 Minuten aktiv, 20 Minuten Abklingzeit." },
    "leben": 2500,
    "schwaeche": ["Feuer"],
    "resistenz": ["Gift (immun)", "Geist (immun)"]
  },
  "vorbereitung": [
    { "item": "antler-pickaxe", "grund": "Damit baust du Kupfer und Zinn ab. Ohne sie kommst du nicht weiter.", "pflicht": true },
    { "item": "workbench", "grund": "Schmelze, Köhler und Schmiede müssen in der Nähe einer Werkbank gebaut werden. Stell eine ins neue Lager.", "pflicht": true },
    { "item": "torch", "grund": "Grabkammern sind stockfinster, und nachts siehst du im Wald fast nichts.", "pflicht": true },
    { "item": "wood-shield", "grund": "Graudwerge werfen Steine und kommen in Gruppen. Mit Schild (L2) überlebst du das.", "pflicht": false },
    { "item": "flint-arrow", "grund": "Bogen und Pfeile für Schamanen und Trolle auf Distanz.", "pflicht": false },
    { "item": "leather-tunic", "grund": "Etwas Rüstung für die ersten Nächte, bis die Bronzerüstung steht.", "pflicht": false },
    { "item": "cooked-meat", "grund": "Essen ist Rüstung. Nimm dir drei verschiedene Sorten mit.", "pflicht": false }
  ],
  "gefahren": [
    {
      "id": "greydwarf",
      "name": { "de": "Graudwerg", "en": "Greydwarf" },
      "gefahr": 2,
      "schwaeche": ["Feuer"],
      "resistenz": ["Gift"],
      "tipp": "Der Standardgegner im Wald, tagsüber wenige, nachts bis zu sechs auf einmal. Nahkampf-Schlag und Steinwurf. Mit Schild und freiem Rücken hältst du sie dir vom Leib. Graudwerg-Nester spucken immer neue aus, also nicht daneben campen.",
      "drops": ["greydwarf-eye", "wood", "stone", "resin", "greydwarf-trophy"]
    },
    {
      "id": "greydwarf-brute",
      "name": { "de": "Graudwerg-Brutmutter", "en": "Greydwarf brute" },
      "gefahr": 3,
      "schwaeche": ["Feuer"],
      "resistenz": ["Gift"],
      "tipp": "Groß, langsam und schlägt hart (30 Schaden pro Hieb). Erscheint nur nachts, selten auch aus Nestern. Aus der Distanz anschießen oder dem Hieb ausweichen und sofort zuschlagen. Lässt Uralte Samen fallen, die du für den Ältesten brauchst.",
      "drops": ["ancient-seed", "dandelion", "greydwarf-eye", "stone", "wood", "greydwarf-brute-trophy"]
    },
    {
      "id": "greydwarf-shaman",
      "name": { "de": "Graudwerg-Schamane", "en": "Greydwarf shaman" },
      "gefahr": 3,
      "schwaeche": ["Feuer"],
      "resistenz": ["Gift"],
      "tipp": "Heilt andere Graudwerge und schießt Gift auf Distanz. Hat wenig Leben (60), also zuerst ausschalten, am besten mit dem Bogen, bevor du dich um den Rest kümmerst.",
      "drops": ["greydwarf-eye", "resin", "wood", "greydwarf-shaman-trophy"]
    },
    {
      "id": "troll",
      "name": { "de": "Troll", "en": "Troll" },
      "gefahr": 4,
      "schwaeche": ["Stich"],
      "resistenz": ["Stumpf"],
      "tipp": "600 Leben, langsam, aber ein Treffer kann dich schwer verwunden. Ausweichrolle (L2 + Kreis) unter dem Schlag durch, dann zuschlagen. Stich ist seine Schwäche, also Bogen oder Speer, am besten auf den Kopf zielen. Nie im Dunkeln und nie ohne Bronzerüstung herausfordern.",
      "drops": ["troll-hide", "troll-trophy"]
    },
    {
      "id": "skeleton",
      "name": { "de": "Skelett", "en": "Skeleton" },
      "gefahr": 2,
      "schwaeche": ["Stumpf", "Feuer"],
      "resistenz": ["Stich", "Frost"],
      "tipp": "Wacht vor und in Grabkammern, manche haben einen Bogen. Wenig Leben (40). Mit Keule oder Streitkolben ist es schnell vorbei, Pfeile und Speer sind weniger wirksam.",
      "drops": ["bone-fragments", "skeleton-trophy"]
    },
    {
      "id": "ghost",
      "name": { "de": "Geist", "en": "Ghost" },
      "gefahr": 3,
      "schwaeche": ["Geist"],
      "resistenz": ["Stumpf", "Hieb", "Stich", "Gift"],
      "tipp": "Schwebt in Grabkammern durch Wände und nimmt von normalen Waffen weniger Schaden. Er hat nur 60 Leben, also geduldig draufhalten statt fliehen.",
      "drops": ["ectoplasm", "ghost-trophy"]
    },
    {
      "id": "bear",
      "name": { "de": "Bär", "en": "Bear" },
      "gefahr": 3,
      "schwaeche": ["Feuer"],
      "resistenz": ["Frost", "Stumpf", "Stich"],
      "tipp": "800 Leben, beißt, kratzt und schlägt zu. Er scheut Feuer: Eine Fackel in der Hand und der Bär im Blick hält ihn auf Abstand. Mit Schwert oder Axt (Hieb) statt Speer oder Keule kämpfen. Frisst gern Blaubeeren vom Boden.",
      "drops": ["bear-hide", "bear-meat", "bear-paw", "bear-trophy"]
    }
  ],
